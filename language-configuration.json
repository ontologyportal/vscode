{
    "comments": {
        "lineComment": ";"
    },
    "brackets": [
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string"] }
    ],
    "surroundingPairs": [
        ["(", ")"],
        ["\"", "\""]
    ],
    "indentationRules": {
        "increaseIndentPattern": "\\([^)]*$",
        "decreaseIndentPattern": "^\\s*\\)"
    },
    "folding": {
        "markers": {
            "start": "^\\s*\\(",
            "end":   "^\\s*\\)"
        }
    },
    "wordPattern": "[?@]?[A-Za-z_][A-Za-z0-9_\\-]*"
}
