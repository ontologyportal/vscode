; Simple test fixture for SUMO VSCode integration tests.
; Contains a well-formed taxonomy with documentation for every defined term.

(subclass Entity Entity)
(subclass Abstract Entity)
(subclass Physical Entity)
(subclass Animal Physical)
(subclass Mammal Animal)
(subclass Cat Mammal)
(subclass Dog Mammal)

(instance Rover Dog)

(documentation Cat EnglishLanguage "A domesticated feline mammal.")
(documentation Dog EnglishLanguage "A domesticated canine mammal.")
(documentation Rover EnglishLanguage "A specific dog instance used as a test fixture.")

(instance knows BinaryRelation)
(domain knows 1 Agent)
(domain knows 2 Entity)
(documentation knows EnglishLanguage "A relation indicating that one agent knows something.")
